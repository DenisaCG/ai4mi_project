#!/bin/bash
#SBATCH --job-name=context_25d_examples
#SBATCH --partition=rome
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=16G
#SBATCH --time=00:20:00
#SBATCH --output=jobsAndOutputs/25d_context/outputs/%x_%j.out

# Esophagus slices where U-Net 2.5D stride 4 loses the most Dice against 2D (seed 0), for visual inspection.
# Usage: sbatch jobsAndOutputs/25d_context/jobs/context_25d_examples.job   (from the repo root)
set -euo pipefail
source jobsAndOutputs/pipeline/jobs/env_setup.sh

python -B dataset_analysis/context_25d_examples.py --patients Patient_11 Patient_33 Patient_32 \
    --runs-dir runs --out-dir figures/context_25d_regions
echo "[$(date -Is)] done"
