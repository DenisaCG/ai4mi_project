#!/bin/bash
#SBATCH --job-name=augmentation_figures
#SBATCH --partition=rome
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=4G
#SBATCH --time=00:10:00
#SBATCH --output=jobsAndOutputs/augmentation/outputs/%x_%j.out

# Augmentation screening and joint-recipe figures from docs/augmentation_results/per_run.csv.
# Usage: sbatch jobsAndOutputs/augmentation/jobs/augmentation_figures.job   (from the repo root)
set -euo pipefail
source jobsAndOutputs/pipeline/jobs/env_setup.sh

python -B dataset_analysis/augmentation_figures.py --out-dir figures/augmentation
echo "[$(date -Is)] done"
