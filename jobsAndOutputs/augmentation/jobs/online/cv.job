#!/bin/bash
#SBATCH --job-name=online_augmentation_cv
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --gpus=1
#SBATCH --time=00:45:00
#SBATCH --array=0-11
#SBATCH --output=jobsAndOutputs/augmentation/outputs/online/%x_%A_%a.out
#SBATCH --error=jobsAndOutputs/augmentation/outputs/online/%x_%A_%a.err

# Submit from the repository root with CONFIG set to an online augmentation YAML.
# The shared CV implementation also serves non-augmentation controls.
exec bash jobsAndOutputs/pipeline/jobs/cv.job
