#!/bin/bash
#SBATCH --job-name=registration_anatomical_initialization
#SBATCH --partition=genoa
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=10G
#SBATCH --time=01:00:00
#SBATCH --output=jobsAndOutputs/augmentation/outputs/registration/%x_%j.out
#SBATCH --error=jobsAndOutputs/augmentation/outputs/registration/%x_%j.err

set -euo pipefail
source jobsAndOutputs/pipeline/jobs/env_setup.sh
export OMP_NUM_THREADS=1 ITK_GLOBAL_DEFAULT_NUMBER_OF_THREADS=1
export OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export PYTHONDONTWRITEBYTECODE=1
output="metrics/augmentation_metrics/registration/smoketest/anatomical_initialization"
stage="${STAGE:?submit with --export=ALL,STAGE=rigid or final}"
if [[ "$stage" != rigid && "$stage" != final ]]; then
    echo "unexpected stage: $stage" >&2
    exit 1
fi
if [[ "$stage" == rigid ]]; then
    if [[ -e "$output" || -L "$output" ]]; then
        echo "diagnostic output already exists; refusing to overwrite: $output" >&2
        exit 1
    fi
    mkdir -p "$output"
else
    if [[ ! -f "$output/reports/rigid.json" || -e "$output/reports/final.json" ]]; then
        echo "rigid report missing or final report already exists" >&2
        exit 1
    fi
fi
mkdir -p "$output/tmp" "$output/matplotlib"
export TMPDIR="$PWD/$output/tmp" MPLCONFIGDIR="$PWD/$output/matplotlib"
/usr/bin/time -v python -B -m src.registration_anatomical_initialization --stage "$stage"
