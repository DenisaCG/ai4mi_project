#!/bin/bash
#SBATCH --job-name=registration_preprocessing_comparison
#SBATCH --partition=genoa
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=12G
#SBATCH --time=02:00:00
#SBATCH --output=jobsAndOutputs/augmentation/outputs/registration/%x_%j.out
#SBATCH --error=jobsAndOutputs/augmentation/outputs/registration/%x_%j.err

set -euo pipefail
source jobsAndOutputs/pipeline/jobs/env_setup.sh
export OMP_NUM_THREADS=1 ITK_GLOBAL_DEFAULT_NUMBER_OF_THREADS=1
export OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export PYTHONDONTWRITEBYTECODE=1
output="metrics/augmentation_metrics/registration/smoketest/preprocessing_comparison"
if [[ -e "$output" || -L "$output" ]]; then
    echo "diagnostic output already exists; refusing to overwrite: $output" >&2
    exit 1
fi
mkdir -p "$output/tmp" "$output/matplotlib"
export TMPDIR="$PWD/$output/tmp" MPLCONFIGDIR="$PWD/$output/matplotlib"

for spec in native:1 resampled:1 native:2 resampled:2; do
    condition="${spec%%:*}"
    repeat="${spec##*:}"
    echo "[$(date -Is)] starting $condition repeat $repeat" >&2
    /usr/bin/time -v python -B -m src.registration_preprocessing_comparison \
        --condition "$condition" --repeat "$repeat"
done

/usr/bin/time -v python -B -m src.registration_preprocessing_comparison --summarize
