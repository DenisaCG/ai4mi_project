#!/bin/bash
#SBATCH --job-name=full40_registration
#SBATCH --partition=genoa
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=02:00:00
#SBATCH --output=jobsAndOutputs/augmentation/outputs/registration/%x_%j.out
#SBATCH --error=jobsAndOutputs/augmentation/outputs/registration/%x_%j.err

# Offline CPU registration for one fold. LIMIT=1 VISUALIZE=1 runs the first-pair pilot;
# omit LIMIT to resume/build all 30 pairs for the selected fold.
# Submit from the repository root:
# sbatch --export=ALL,FOLD=0,LIMIT=1,VISUALIZE=1 jobsAndOutputs/augmentation/jobs/registration/registration.job
set -euo pipefail
FOLD="${FOLD:?set FOLD to 0, 1, 2, or 3}"
LIMIT="${LIMIT:-}"
VISUALIZE="${VISUALIZE:-0}"
source jobsAndOutputs/pipeline/jobs/env_setup.sh
export OMP_NUM_THREADS=4 ITK_GLOBAL_DEFAULT_NUMBER_OF_THREADS=4

configs=(configs/full_cv4_enet_dice_ce_registration.yaml configs/full_cv4_resenc_ds_unet_dice_ce_registration.yaml)
args=(--configs "${configs[@]}" --fold "$FOLD")
if [ -n "$LIMIT" ]; then args+=(--limit "$LIMIT"); fi
if [ "$VISUALIZE" = 1 ]; then args+=(--visualize); fi
python -B -m src.registration "${args[@]}"
