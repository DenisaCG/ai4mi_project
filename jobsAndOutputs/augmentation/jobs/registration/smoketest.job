#!/bin/bash
#SBATCH --job-name=registration_smoketest
#SBATCH --partition=genoa
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=02:00:00
#SBATCH --output=jobsAndOutputs/augmentation/outputs/registration/%x_%j.out
#SBATCH --error=jobsAndOutputs/augmentation/outputs/registration/%x_%j.err

# Same CPU allocation and SimpleITK thread count as registration.job.
set -euo pipefail
source jobsAndOutputs/pipeline/jobs/env_setup.sh
export OMP_NUM_THREADS=4 ITK_GLOBAL_DEFAULT_NUMBER_OF_THREADS=4
/usr/bin/time -v python -B -m src.registration_smoketest
