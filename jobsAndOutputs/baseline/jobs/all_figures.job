#!/bin/bash
#SBATCH --job-name=all_figures
#SBATCH --partition=genoa
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=01:30:00
#SBATCH --output=/home/scur0049/ai4mi_project/jobsAndOutputs/baseline/outputs/all_figures_%j.out

# Regenerates every dataset-analysis figure from one dataset directory, CPU-only.
# Works unchanged whether that dataset has the aorta annotation (label 4) or not.
#
# Usage:
#   sbatch jobsAndOutputs/baseline/jobs/all_figures.job
#   sbatch jobsAndOutputs/baseline/jobs/all_figures.job /path/to/corrected/train figures/corrected /path/to/original/train
#
# Args (both optional, positional):
#   $1  DATA_DIR  raw NIfTI dataset directory (one Patient_XX/ folder per patient)
#                 default: data/segthor_part1/train
#   $2  OUT_DIR   where figures/tables for this run are written; also names the
#                 dataset_analysis/results/<name> subfolder, so a second run
#                 against a different DATA_DIR can be diffed against the first
#                 default: figures
#   $3  BEFORE_DIR optional raw NIfTI dataset to compare against in the HU intensity
#                 figure (drawn upwards, DATA_DIR mirrored downwards, into OUT_DIR/comparison)

set -euo pipefail
PROJECT_DIR="$HOME/ai4mi_project"

module purge
module load 2024
module load Anaconda3/2024.06-1

set +u
source "${EBROOTANACONDA3:-$CONDA_PREFIX}/etc/profile.d/conda.sh"
conda activate ai4mi
set -u

cd "$PROJECT_DIR"
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MPLCONFIGDIR="$PROJECT_DIR/dataset_analysis/results/.matplotlib"

DATA_DIR="${1:-data/segthor_part1/train}"
OUT_DIR="${2:-figures}"
if [ "$OUT_DIR" = "figures" ]; then
    ANALYSIS_OUT="dataset_analysis/results"
else
    ANALYSIS_OUT="dataset_analysis/results/$(basename "$OUT_DIR")"
fi

BEFORE_ARGS=()
if [ -n "${3:-}" ]; then
    BEFORE_ARGS=(--before-data-dir "$3" --names "before" "after")
fi

python -B -u tools/run_all_figures.py \
    --data-dir "$DATA_DIR" \
    --out-dir "$OUT_DIR" \
    --dataset-analysis-out "$ANALYSIS_OUT" \
    "${BEFORE_ARGS[@]}"
