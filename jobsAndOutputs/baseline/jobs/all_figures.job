#!/bin/bash
#SBATCH --job-name=all_figures
#SBATCH --partition=genoa
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=01:30:00
#SBATCH --output=/home/scur0049/ai4mi_project/jobsAndOutputs/baseline/outputs/all_figures_%j.out

# Regenerates the dataset figures used in the slides, CPU-only: the label and scan figures
# from the corrected 4-label data, plus the before/after figures (HU intensity, connected
# components, label make-up, label-correction example) against the original data.
# Figures are written under OUT_DIR (tools/run_all_figures.py); this job's log goes to
# jobsAndOutputs/baseline/outputs.
#
# Usage:
#   sbatch jobsAndOutputs/baseline/jobs/all_figures.job
#   sbatch jobsAndOutputs/baseline/jobs/all_figures.job [DATA_DIR [OUT_DIR [BEFORE_DIR]]]
#
# Args (all optional, positional):
#   $1  DATA_DIR   raw NIfTI dataset directory (one Patient_XX/ folder per patient)
#                  default: data/segthor_part1_corrected/train
#   $2  OUT_DIR    where figures/tables for this run are written
#                  default: figures
#   $3  BEFORE_DIR raw NIfTI dataset drawn as "before" in the comparison figures
#                  (written to OUT_DIR/comparison)
#                  default: data/segthor_part1/train

set -euo pipefail
PROJECT_DIR="$HOME/ai4mi_project"

module purge
module load 2024
module load Anaconda3/2024.06-1

set +u
source "${EBROOTANACONDA3:-$CONDA_PREFIX}/etc/profile.d/conda.sh"
conda activate ai4mi
set -u

cd "$PROJECT_DIR"
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MPLCONFIGDIR="$PROJECT_DIR/dataset_analysis/results/.matplotlib"

DATA_DIR="${1:-data/segthor_part1_corrected/train}"
OUT_DIR="${2:-figures}"
BEFORE_DIR="${3:-data/segthor_part1/train}"

python -B -u tools/run_all_figures.py \
    --data-dir "$DATA_DIR" \
    --out-dir "$OUT_DIR" \
    --before-data-dir "$BEFORE_DIR" \
    --names "3 labels (aorta merged)" "4 labels (aorta separate)"
