#!/bin/bash
#SBATCH --job-name=baseline_median_runs
#SBATCH --partition=genoa
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=8G
#SBATCH --time=00:30:00
#SBATCH --output=/home/scur0049/ai4mi_project/jobsAndOutputs/baseline/outputs/baseline_median_runs_%j.out

# Rebuild the baseline stage (tables + 3 Dice figures + validation) of both analysis folders from one seeded pipeline
# run per label version: the run with the median foreground Dice of its 9 runs (rule fixed before looking at the plots).
# The dataset stage (GT-only tables/figures/examples) is untouched. Pipeline runs already save val predictions and
# volumes stitched onto the original CT grid, so no stitching is needed.
set -euo pipefail
PROJECT_DIR="$HOME/ai4mi_project"

BEFORE_RUN="${BEFORE_RUN:-runs/segthor_enet_ce_repro/seed2}"
AFTER_RUN="${AFTER_RUN:-runs/segthor_enet_ce_repro_corrected_fixed/seed7}"

module purge
module load 2024
module load Anaconda3/2024.06-1
set +u
source "${EBROOTANACONDA3:-$CONDA_PREFIX}/etc/profile.d/conda.sh"
conda activate ai4mi
set -u

cd "$PROJECT_DIR"
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MPLCONFIGDIR="$PROJECT_DIR/dataset_analysis/results/.matplotlib"

python -B -u dataset_analysis/test_analysis.py

baseline_stage() {  # name, raw GT dir, processed data dir, run dir
    local name="$1" original="$2" processed="$3" run="$4"
    local out="dataset_analysis/results/repro_${name}_seed0"
    echo "=== $name: baseline from $run"
    python -B -u dataset_analysis/analyze_baseline.py --original-data "$original" --processed-data "$processed" \
        --predictions "$run/predictions/val" --reconstructed-volumes "$run/volumes/val" --output-dir "$out"
    python -B -u dataset_analysis/validate_results.py --original-data "$original" --processed-data "$processed" --output-dir "$out"
}

baseline_stage original data/segthor_part1/train data/SEGTHOR "$BEFORE_RUN"
baseline_stage corrected data/segthor_part1_corrected/train data/SEGTHOR_corrected "$AFTER_RUN"
