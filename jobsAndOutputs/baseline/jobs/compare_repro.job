#!/bin/bash
#SBATCH --job-name=compare_repro
#SBATCH --partition=genoa
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=4G
#SBATCH --time=00:05:00
#SBATCH --output=jobsAndOutputs/baseline/outputs/compare_repro_%j.out

# Usage (from the repo root): sbatch jobsAndOutputs/baseline/jobs/compare_repro.job
# Overrides: --export=ALL,ORIG="results/segthor/ce_repro_original/run0",PIPE="runs/segthor_enet_ce_repro/seed0",OUT=...,CLASSES="esophagus heart trachea"
set -euo pipefail
module purge
module load 2024
module load Anaconda3/2024.06-1
set +u
source "${EBROOTANACONDA3:-$CONDA_PREFIX}/etc/profile.d/conda.sh"
conda activate ai4mi
set -u

cd "$SLURM_SUBMIT_DIR"
ORIG="${ORIG:-$(ls -d results/segthor/ce_repro_corrected/run* | tr '\n' ' ')}"
PIPE="${PIPE:-$(ls -d runs/segthor_enet_ce_repro_corrected/seed* | tr '\n' ' ')}"
OUT="${OUT:-results/repro_check_corrected}"
CLASSES="${CLASSES:-esophagus heart trachea aorta}"
export MPLCONFIGDIR="$TMPDIR/mpl"
python -B compare_repro.py --original $ORIG --pipeline $PIPE --out "$OUT" --class-names $CLASSES
