#!/bin/bash
#SBATCH --job-name=segthor_analysis_corrected
#SBATCH --partition=genoa
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=8G
#SBATCH --time=00:15:00
#SBATCH --output=/home/scur0049/ai4mi_project/jobsAndOutputs/baseline/outputs/dataset_analysis_corrected_%j.out

set -euo pipefail
PROJECT_DIR="$HOME/ai4mi_project"

module purge
module load 2024
module load Anaconda3/2024.06-1

set +u
source "${EBROOTANACONDA3:-$CONDA_PREFIX}/etc/profile.d/conda.sh"
conda activate ai4mi
set -u

cd "$PROJECT_DIR"
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MPLCONFIGDIR="$PROJECT_DIR/dataset_analysis/results/.matplotlib"

ORIGINAL_DATA="data/segthor_part1_corrected/train"
PROCESSED_DATA="data/SEGTHOR_corrected"

python -B -u dataset_analysis/test_analysis.py
if [ "${ANALYSIS_SMOKE:-0}" = "1" ]; then
    OUT="dataset_analysis/results/corrected_smoke"
    python -B -u dataset_analysis/analyze_dataset.py --original-data "$ORIGINAL_DATA" --processed-data "$PROCESSED_DATA" --max-patients 2 --output-dir "$OUT"
    python -B -u dataset_analysis/analyze_baseline.py --original-data "$ORIGINAL_DATA" --processed-data "$PROCESSED_DATA" --output-dir "$OUT"
    python -B -u dataset_analysis/validate_results.py --original-data "$ORIGINAL_DATA" --processed-data "$PROCESSED_DATA" --output-dir "$OUT"
else
    OUT="dataset_analysis/results/corrected"
    python -B -u dataset_analysis/analyze_dataset.py --original-data "$ORIGINAL_DATA" --processed-data "$PROCESSED_DATA" --output-dir "$OUT"
    python -B -u dataset_analysis/analyze_baseline.py --original-data "$ORIGINAL_DATA" --processed-data "$PROCESSED_DATA" --output-dir "$OUT"
    python -B -u dataset_analysis/validate_results.py --original-data "$ORIGINAL_DATA" --processed-data "$PROCESSED_DATA" --output-dir "$OUT"
fi
