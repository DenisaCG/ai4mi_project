#!/bin/bash
#SBATCH --job-name=score_nnunet
#SBATCH --partition=genoa
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=8G
#SBATCH --time=00:20:00
#SBATCH --output=/home/scur0049/ai4mi_project/jobsAndOutputs/baseline/outputs/score_nnunet_%j.out

# Score the nnU-Net 2D fold-0 validation predictions (with and without test-time augmentation) with the same
# 3D Dice/HD95/ASSD code as our own runs. Run this before compare_before_after.job, which reads the results.
# nnU-Net's validation/ folder is its built-in end-of-training validation (default mirroring TTA);
# validation_no_tta/ was predicted afterwards with TTA disabled.
set -euo pipefail
PROJECT_DIR="$HOME/ai4mi_project"
NNUNET_FOLD="${NNUNET_FOLD:-$HOME/ai4mi_project-nnunet/results/nnunet/Dataset102_SegTHOR_corrected/nnUNetTrainer_100epochs__nnUNetPlans__2d/fold_0}"

module purge
module load 2024
module load Anaconda3/2024.06-1

set +u
source "${EBROOTANACONDA3:-$CONDA_PREFIX}/etc/profile.d/conda.sh"
conda activate ai4mi
set -u

cd "$PROJECT_DIR"
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MPLCONFIGDIR="$PROJECT_DIR/dataset_analysis/results/.matplotlib"

for variant in "2d_tta:validation" "2d_no_tta:validation_no_tta"; do
    python -B -u dataset_analysis/score_nnunet.py \
        --predictions "$NNUNET_FOLD/${variant#*:}" \
        --output-dir "dataset_analysis/results/nnunet/${variant%%:*}"
done
