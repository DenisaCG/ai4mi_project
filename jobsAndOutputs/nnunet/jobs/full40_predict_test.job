#!/bin/bash
#SBATCH --job-name=nnunet40_predict_test
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --gpus=1
#SBATCH --time=03:00:00
#SBATCH --output=jobsAndOutputs/nnunet/outputs/%x_%j.out

# nnU-Net on the 20 test CTs (Patient_41..60, no ground truth), for the side-by-side figure and the timing slide.
#  1. Predictions: the 4 fold models (trained on 30 patients each) as nnU-Net's default ensemble, TTA on, for 2d and 3d_fullres
#     -> $BASE/test_predictions/<configuration>/Patient_XX.nii.gz (original CT grid).
#  2. Timing, same A100 partition as our own models: wall time of the whole nnUNetv2_predict command (preprocessing, model load,
#     sliding-window forward, export) for ONE fold model on 1 CT and on all 20; the per-patient time is (T20 - T1) / 19 so the model
#     load and start-up cancel. With and without nnU-Net's mirroring TTA. Written to $BASE/test_predictions/timing.csv.
# Submit from the repo root: sbatch jobsAndOutputs/nnunet/jobs/full40_predict_test.job
set -euo pipefail
source jobsAndOutputs/nnunet/jobs/full40_env.sh
TEST_DIR="$HOME/ai4mi_project/data/segthor_train_full/test"
IN="$BASE/test_input"; ONE="$BASE/test_input_one"; OUT="$BASE/test_predictions"; TMP="$BASE/test_timing_tmp"
mkdir -p "$IN" "$ONE" "$OUT"
n=0; for f in "$TEST_DIR"/Patient_*.nii.gz; do id=$(basename "$f" .nii.gz); ln -sf "$f" "$IN/${id}_0000.nii.gz"; n=$((n+1)); done
echo "$n test CTs linked"; [ "$n" = 20 ] || { echo "expected 20 test CTs"; exit 1; }
ln -sf "$TEST_DIR/Patient_41.nii.gz" "$ONE/Patient_41_0000.nii.gz"
nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv

now() { date +%s.%N; }
echo "configuration,tta,folds,t_1_patient_s,t_20_patients_s,per_patient_s" > "$OUT/timing.csv"
for cfg in 3d_fullres 2d; do
  for mode in tta no_tta; do
    flag=""; [ "$mode" = no_tta ] && flag="--disable_tta"
    # untimed warm-up so the first call does not pay for cuDNN autotuning / file cache
    rm -rf "$TMP"; nnUNetv2_predict -i "$ONE" -o "$TMP" -d "$DATASET_ID" -c "$cfg" -tr "$TRAINER" -f 0 -chk checkpoint_final.pth $flag > /dev/null
    rm -rf "$TMP"; t0=$(now); nnUNetv2_predict -i "$ONE" -o "$TMP" -d "$DATASET_ID" -c "$cfg" -tr "$TRAINER" -f 0 -chk checkpoint_final.pth $flag > /dev/null; t1=$(now)
    rm -rf "$TMP"; nnUNetv2_predict -i "$IN" -o "$TMP" -d "$DATASET_ID" -c "$cfg" -tr "$TRAINER" -f 0 -chk checkpoint_final.pth $flag > /dev/null; t2=$(now)
    python - "$cfg" "$mode" "$t0" "$t1" "$t2" >> "$OUT/timing.csv" <<'PY'
import sys
cfg, mode, t0, t1, t2 = sys.argv[1], sys.argv[2], *map(float, sys.argv[3:])
one, twenty = t1 - t0, t2 - t1
print(f"{cfg},{mode == 'tta'},1,{one:.1f},{twenty:.1f},{(twenty - one) / 19:.2f}")
PY
    tail -1 "$OUT/timing.csv"
  done
  echo "--- $cfg: default 4-fold ensemble with TTA on all 20 CTs ---"
  t0=$(now)
  nnUNetv2_predict -i "$IN" -o "$OUT/$cfg" -d "$DATASET_ID" -c "$cfg" -tr "$TRAINER" -f 0 1 2 3 -chk checkpoint_final.pth --continue_prediction
  t1=$(now)
  python -c "print('$cfg 4-fold ensemble, 20 CTs, wall: %.1f s' % ($t1 - $t0))" | tee -a "$OUT/ensemble_wall_time.txt"
  ls "$OUT/$cfg"/Patient_*.nii.gz | wc -l
done
rm -rf "$TMP"
echo "[$(date -Is)] done"; cat "$OUT/timing.csv"
