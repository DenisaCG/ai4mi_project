#!/bin/bash
#SBATCH --job-name=nnunet40_score
#SBATCH --partition=genoa
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=01:00:00
#SBATCH --output=jobsAndOutputs/nnunet/outputs/%x_%j.out

# Score every finished fold with the project's own 3D metrics (Dice, HD95, ASSD in mm on the original grid,
# dataset_analysis/score_nnunet.py) for each configuration and TTA setting, then pool the 4 folds.
# Usage: sbatch jobsAndOutputs/nnunet/jobs/full40_score.job
set -euo pipefail
TRAINER="${TRAINER:-nnUNetTrainer_250epochs}"
DATASET=Dataset103_SegTHOR_full40
RESULTS="/scratch-shared/$USER/nnunet_full40/results/$DATASET"
OUT="$HOME/ai4mi_project/dataset_analysis/results/nnunet_full40"
GT="$HOME/ai4mi_project/data/segthor_train_full/train"
module purge; module load 2024 Anaconda3/2024.06-1
set +u; source "$EBROOTANACONDA3/etc/profile.d/conda.sh"; conda activate ai4mi; set -u
cd "$HOME/ai4mi_project"
for cfg in 2d 3d_fullres; do
  for variant in validation:tta validation_no_tta:no_tta; do
    src=${variant%%:*}; tag=${variant##*:}
    for fold in 0 1 2 3; do
      d="$RESULTS/${TRAINER}__nnUNetPlans__$cfg/fold_$fold/$src"
      [ -d "$d" ] || { echo "skip $cfg $tag fold $fold: $d missing"; continue; }
      python dataset_analysis/score_nnunet.py --predictions "$d" --ground-truth-dir "$GT" \
        --output-dir "$OUT/${cfg}_${tag}/fold$fold"
    done
  done
done
python - "$OUT" <<'PY'
import sys, pandas as pd
from pathlib import Path
out = Path(sys.argv[1]); rows = []
for f in sorted(out.glob("*/fold*/eval/metrics_3d.csv")):
    d = pd.read_csv(f); d["config"] = f.parts[-4]; d["fold"] = f.parts[-3]; rows.append(d)
all_ = pd.concat(rows); all_.to_csv(out / "all_folds.csv", index=False)
per_org = all_.groupby(["config", "class_name"])[["dice", "hd95", "assd"]].mean().unstack("class_name")
fg = all_.groupby(["config", "fold", "patient"])[["dice", "hd95", "assd"]].mean().groupby(["config", "fold"]).mean().groupby("config").agg(["mean", "std"])
print(per_org.round(3).to_string()); print(); print(fg.round(3).to_string())
fg.to_csv(out / "summary_fg.csv")
PY
