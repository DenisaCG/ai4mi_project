#!/bin/bash
#SBATCH --job-name=prob_score
#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --cpus-per-task=9
#SBATCH --time=00:30:00
#SBATCH --output=jobsAndOutputs/pipeline/outputs/%x_%j.out

# Score probability-based post-processing (averaged probabilities, confidence gating, DenseCRF) from the saved softmax of
# prob_infer.job; CPU work. Needs results/seed_ensemble/rows.csv for the reference rows.
# Usage: sbatch --export=ALL,EXPERIMENT=full_cv4_resenc_ds_unet_dice_ce,OUT=results/prob_postprocess,ARGS="--variants repro avg crf_a" jobsAndOutputs/pipeline/jobs/prob_score.job
set -euo pipefail
EXPERIMENT="${EXPERIMENT:?set EXPERIMENT=<cv experiment without _fold<k>> via --export}"
OUT="${OUT:-results/prob_postprocess}"
source jobsAndOutputs/pipeline/jobs/env_setup.sh

export OMP_NUM_THREADS=1
export PYTHONPATH="$HOME/pydensecrf_site${PYTHONPATH:+:$PYTHONPATH}"
python -m unittest tests.test_prob_postprocess
# shellcheck disable=SC2086
python -O -m tools.prob_postprocess score --experiment "$EXPERIMENT" --workers "$SLURM_CPUS_PER_TASK" --out "$OUT" ${ARGS:-}
echo "[$(date -Is)] done: $OUT"
